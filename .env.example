# Base PostgreSQL (Supabase : utiliser l'URL du pooler en mode transaction, port 6543, région UE)
DATABASE_URL=postgres://user:password@host:6543/postgres
# Secret HMAC (32+ caractères aléatoires) : openssl rand -base64 48
APP_SECRET=
# Empreinte du mot de passe admin : npm run admin:hash -- "mot de passe long"
ADMIN_PASSWORD_HASH=
# Secret de la tâche quotidienne de purge (Vercel Cron l'envoie automatiquement)
CRON_SECRET=
# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://voix.example
